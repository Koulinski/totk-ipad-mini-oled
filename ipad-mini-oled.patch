+static void configure_graphics(void) {
+    NSString *const profileKey = @"TOTK_IOS_GRAPHICS_PROFILE";
+    NSString *const frameGenerationKey = @"TOTK_IOS_FRAME_GENERATION";
+    NSUserDefaults *defaults = NSUserDefaults.standardUserDefaults;
+    const char *override = getenv("TOTK_IOS_GRAPHICS_PROFILE");
+    NSString *profile = override ? [NSString stringWithUTF8String:override]
+        : [defaults stringForKey:profileKey];
+    if (!override && [profile isEqualToString:@"1080-native-fg60"]) {
+        // Move the old combined preset to the new independent preferences.
+        if (![defaults objectForKey:frameGenerationKey]) [defaults setBool:YES forKey:frameGenerationKey];
+        profile = @"1080-native";
+        [defaults setObject:profile forKey:profileKey];
+    } else if (!override && ![profile isEqualToString:@"720-native"] &&
+               ![profile isEqualToString:@"900-native"] && ![profile isEqualToString:@"900-native-60"] &&
+               ![profile isEqualToString:@"1080-native"] && ![profile isEqualToString:@"1044-full-height-60"]) {
+        if (profile) [defaults setObject:@"720-native" forKey:profileKey];
+        profile = @"720-native";
+    }
+
+    char machine[32] = {0};
+    size_t machineSize = sizeof(machine);
+    BOOL oledMini = sysctlbyname("hw.machine", machine, &machineSize, NULL, 0) == 0 &&
+        !strcmp(machine, "iPad19,1");
+    if (!oledMini && [profile isEqualToString:@"1044-full-height-60"]) profile = @"900-native-60";
+    BOOL fullHeight = [profile isEqualToString:@"1044-full-height-60"];
+    BOOL docked60 = override && [profile isEqualToString:@"1080-native-60"];
+    BOOL scene900At60 = [profile isEqualToString:@"900-native-60"];
+    BOOL scene900 = scene900At60 || [profile isEqualToString:@"900-native"];
+    BOOL interpolated60 = !fullHeight && (override ? [profile isEqualToString:@"1080-native-fg60"]
+        : !scene900At60 && [defaults boolForKey:frameGenerationKey]);
+    BOOL fixedProfile = fullHeight || docked60 || scene900At60 || interpolated60;
+    BOOL docked = fullHeight || docked60 || scene900 || [profile isEqualToString:@"1080-native"] ||
+        [profile isEqualToString:@"1080-native-fg60"];
+    BOOL nativeOutput = docked || [profile isEqualToString:@"720-native"];
+    const char *hz = nativeOutput && !fixedProfile ? "30" : "60";
+    const char *scene = fullHeight ? "1600x1044" : scene900 ? "1600x900" : docked ? "1920x1080" : nativeOutput ? "1280x720" : "960x540";
+
+    // The full-height preset also selects a taller guest canvas before the signed guest starts.
+    setenv("TOTK_IPAD_FULL_HEIGHT", fullHeight ? "1" : "0", 1);
+    setenv("TOTK_OPERATION_MODE", docked ? "docked" : "handheld", 1);
+    setenv("TOTK_RENDER_RES", scene, fixedProfile);
+    setenv("TOTK_IOS_DRAWABLE_H", nativeOutput ? "0" : "720", fixedProfile);
+    setenv("TOTK_MFX_UPSCALE", "1", fixedProfile);
+    setenv("TOTK_MFX_OUTPUT", "1", fixedProfile);
+    setenv("TOTK_MFX", interpolated60 ? "interp60" : nativeOutput ? "0" : "interp30", fixedProfile);
+    setenv("DM_PRESENT_HZ", hz, fixedProfile);
+    setenv("DM_PRESENT_INTERVAL", "display", fixedProfile);
+    setenv("DM_FPS", hz, fixedProfile);
+    setenv("TOTK_UNCAPPED", "0", fixedProfile);
+    if (fixedProfile) setenv("DM_RT_AB", "0", 1);
+    if ((scene900At60 || fullHeight) && oledMini) {
+        // The 900p real-60 route benefited from the encoding worker on this iPad.
+        setenv("TOTK_RENDER_STREAM", "1", 0);
+    }
+    const char *frameGeneration = getenv("TOTK_MFX") ?: "0";
+    fprintf(stderr, "[totk] iOS graphics profile: %s (frame generation %s)\n",
+            nativeOutput ? profile.UTF8String : "default",
+            !strcmp(frameGeneration, "0") ? "off" : !strcmp(frameGeneration, "interp60") ? "60 FPS cap" : frameGeneration);
+}
