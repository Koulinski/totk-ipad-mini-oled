+/* Included by nvn_mtl.m after the ordinary render descriptor builder. */
+#if TARGET_OS_IPHONE
+enum { M4_ARCHIVE_LIMIT = 128, M4_ARCHIVE_MAX_MIB = 96 };
+
+@interface NvM4Archive : NSObject
