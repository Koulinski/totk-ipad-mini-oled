+static int m4_archive_mode(void) {
+    static int mode;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        const char *e = getenv("TOTK_MTL4_ARCHIVE");
+        if (!getenv("DM_NVN_HILITE") && !getenv("TOTK_GPU_HILITE1") && !getenv("TOTK_NAN_TRACE"))
+            mode = e ? atoi(e) : 1;
+    });
+    return mode;
+}
+
+static NSURL *m4_archive_directory(void) {
+    const char *mode = getenv("TOTK_OPERATION_MODE");
+    const char *profile = mode && !strcmp(mode, "docked") ? "docked" : "handheld";
+    return [NSURL fileURLWithPath:[totk_rt_dir() stringByAppendingFormat:@"/metal4-pso-v1-%s-%s", DMSH_CHAIN, profile]
+                     isDirectory:YES];
+}
+
+static bool m4_archive_filename(NSString *name) {
+    if (name.length != 55 || ![name hasPrefix:@"pipelines-"] || ![name hasSuffix:@".metalbin"]) return false;
+    return [[NSUUID alloc] initWithUUIDString:[name substringWithRange:NSMakeRange(10, 36)]] != nil;
+}
+
+static NvM4Archive *m4_archive_open(NSURL *url, NSSet *keys) {
+    NSNumber *size;
+    if (![url getResourceValue:&size forKey:NSURLFileSizeKey error:nil] ||
+        !size.unsignedLongLongValue || size.unsignedLongLongValue > ((uint64_t)M4_ARCHIVE_MAX_MIB << 20)) return nil;
+    NSError *error = nil;
+    id<MTL4Archive> archive = [g_dev newArchiveWithURL:url error:&error];
+    if (!archive) {
+        MLOG("[metal4-archive] could not load: %s", error.localizedDescription.UTF8String ?: "unknown error");
+        return nil;
+    }
+    NvM4Archive *snapshot = [NvM4Archive new];
+    snapshot.archive = archive;
+    snapshot.keys = keys;
+    return snapshot;
+}
+
+static NvM4Archive *m4_archive_load_index(NSURL *dir, NSString **filename) {
+    NSURL *index = [dir URLByAppendingPathComponent:@"current.plist"];
+    NSNumber *size;
+    if (![index getResourceValue:&size forKey:NSURLFileSizeKey error:nil] ||
+        size.unsignedLongLongValue > (256u << 10)) return nil;
+    NSDictionary *record = [NSDictionary dictionaryWithContentsOfURL:index error:nil];
+    NSString *name = record[@"file"];
+    NSArray *keys = record[@"keys"];
+    if (![name isKindOfClass:NSString.class] || !m4_archive_filename(name) ||
+        ![keys isKindOfClass:NSArray.class] || !keys.count || keys.count > M4_ARCHIVE_LIMIT) return nil;
+    NSMutableSet *recipes = [NSMutableSet setWithCapacity:keys.count];
+    for (id key in keys) {
+        if ([key isKindOfClass:NSData.class] && [key length] == sizeof(pso_skey)) {
+            // Older indexes used raw color state for the same Metal descriptor.
+            pso_skey recipe;
+            [key getBytes:&recipe length:sizeof recipe];
+            pso_key_norm(&recipe.k, recipe.merged);
+            [recipes addObject:[NSData dataWithBytes:&recipe length:sizeof recipe]];
+        } else if ([key isKindOfClass:NSString.class] && pso_priority_shader_key([key UTF8String], 80)) {
+            [recipes addObject:key];
+        } else return nil;
+    }
+    *filename = name;
+    return m4_archive_open([dir URLByAppendingPathComponent:name], recipes);
+}
