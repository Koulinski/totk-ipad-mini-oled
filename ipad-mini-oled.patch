+            MLOG("[metal4-archive] opened %lu exact recipes from disk", (unsigned long)g_m4_archive.keys.count);
+        }
+        for (NSURL *item in [NSFileManager.defaultManager contentsOfDirectoryAtURL:dir includingPropertiesForKeys:nil options:0 error:nil])
+            if (![item.lastPathComponent isEqualToString:name] && m4_archive_filename(item.lastPathComponent))
+                [NSFileManager.defaultManager removeItemAtURL:item error:nil];
+    });
+}
+
+static NvM4Archive *m4_archive_candidate(id key) {
+    if (!atomic_load(&g_m4_archive_ready)) return nil;
+    os_unfair_lock_lock(&g_m4_archive_lock);
+    NvM4Archive *snapshot = g_m4_archive;
+    os_unfair_lock_unlock(&g_m4_archive_lock);
+    return [snapshot.keys containsObject:key] ? snapshot : nil;
+}
+
+static NSString *m4_archive_seed_prefix(void) {
+    static NSString *seed;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        NSString *prefix = [g_shmap_path.stringByDeletingLastPathComponent stringByAppendingString:@"/"];
+        if ([prefix hasPrefix:[NSBundle.mainBundle.bundlePath stringByAppendingString:@"/"]]) seed = prefix;
+    });
+    return seed;
+}
+
+static bool m4_archive_seed_shader(NvShader *sh) {
+    NSString *seed = m4_archive_seed_prefix();
+    return seed && sh && sh->src_path && [sh->src_path hasPrefix:seed];
+}
+
+static MTL4LibraryFunctionDescriptor *m4_archive_function(NvShader *sh) {
+    if (!m4_archive_seed_shader(sh)) return nil;
+    NSString *path = [[sh->src_path stringByDeletingPathExtension] stringByAppendingPathExtension:@"metallib"];
+    id<MTLLibrary> lib = lib_from_file(path, nil);
+    if (!lib) return nil;
+    MTL4LibraryFunctionDescriptor *d = [MTL4LibraryFunctionDescriptor new];
+    d.library = lib;
+    d.name = sh->fn.name;
+    return d;
+}
+
+static MTL4RenderPipelineDescriptor *m4_archive_render_desc(MTLRenderPipelineDescriptor *base, NvShader *vs, NvShader *fs) {
+    /* MTL4 gets depth/stencil formats from the render pass. The full NVN key
+       still includes both formats and all state the ordinary descriptor uses. */
+    if (base.vertexFunction != vs->fn || (fs && base.fragmentFunction != fs->fn)) return nil;
+    MTL4LibraryFunctionDescriptor *vertex = m4_archive_function(vs);
+    MTL4LibraryFunctionDescriptor *fragment = m4_archive_function(fs);
+    if (!vertex || (fs && !fragment)) return nil;
+    MTL4RenderPipelineDescriptor *d = [MTL4RenderPipelineDescriptor new];
+    d.vertexFunctionDescriptor = vertex;
+    d.fragmentFunctionDescriptor = fragment;
+    d.vertexDescriptor = base.vertexDescriptor;
+    d.rasterSampleCount = base.rasterSampleCount;
+    d.alphaToCoverageState = base.alphaToCoverageEnabled ? MTL4AlphaToCoverageStateEnabled : MTL4AlphaToCoverageStateDisabled;
+    d.rasterizationEnabled = base.rasterizationEnabled;
+    d.inputPrimitiveTopology = base.inputPrimitiveTopology;
+    for (int i = 0; i < 8; i++) {
+        MTLRenderPipelineColorAttachmentDescriptor *src = base.colorAttachments[i];
+        if (src.pixelFormat == MTLPixelFormatInvalid) continue;
+        MTL4RenderPipelineColorAttachmentDescriptor *dst = d.colorAttachments[i];
+        dst.pixelFormat = src.pixelFormat;
+        dst.writeMask = src.writeMask;
+        dst.blendingState = src.blendingEnabled ? MTL4BlendStateEnabled : MTL4BlendStateDisabled;
+        if (!src.blendingEnabled) continue;
+        dst.sourceRGBBlendFactor = src.sourceRGBBlendFactor;
+        dst.destinationRGBBlendFactor = src.destinationRGBBlendFactor;
+        dst.rgbBlendOperation = src.rgbBlendOperation;
+        dst.sourceAlphaBlendFactor = src.sourceAlphaBlendFactor;
+        dst.destinationAlphaBlendFactor = src.destinationAlphaBlendFactor;
+        dst.alphaBlendOperation = src.alphaBlendOperation;
+    }
+    return d;
+}
+
+static MTL4ComputePipelineDescriptor *m4_archive_compute_desc(NvShader *cs) {
+    MTL4LibraryFunctionDescriptor *function = m4_archive_function(cs);
+    if (!function) return nil;
+    MTL4ComputePipelineDescriptor *d = [MTL4ComputePipelineDescriptor new];
+    d.computeFunctionDescriptor = function;
+    return d;
+}
+
+static void m4_archive_note(bool hit, uint64_t started) {
+    unsigned n = hit ? atomic_fetch_add(&g_m4_archive_hits, 1) + 1 : atomic_fetch_add(&g_m4_archive_misses, 1) + 1;
+    if (n <= 3 || !(n % 8))
+        MLOG("[metal4-archive] %s %u, frame %llu, lookup %.2f ms", hit ? "hit" : "miss", n,
+             (unsigned long long)atomic_load(&g_cur_frame), (bp_now() - started) / 1e6);
+}
+
+static NSData *m4_archive_render_key(const pso_key *k, NvShader *vs, NvShader *fs, bool merged) {
+    if (!atomic_load(&g_m4_archive_ready) || k->fsfn || (k->a2c & ~1u) || !m4_archive_seed_shader(vs) ||
+        (fs && !m4_archive_seed_shader(fs))) return nil;
+    pso_skey recipe;
+    pso_skey_from(k, vs, fs, merged, NULL, &recipe);
+    return [NSData dataWithBytes:&recipe length:sizeof recipe];
+}
+
+static id<MTLRenderPipelineState> m4_archive_render(const pso_key *k, NvShader *vs, NvShader *fs, bool merged) {
+    NSData *key = m4_archive_render_key(k, vs, fs, merged);
+    NvM4Archive *snapshot = key ? m4_archive_candidate(key) : nil;
+    if (!snapshot) return nil;
+    uint64_t started = bp_now();
+    MTL4RenderPipelineDescriptor *d = m4_archive_render_desc(pso_desc(k, vs, fs, nil, merged), vs, fs);
+    id<MTLRenderPipelineState> ps = d ? [snapshot.archive newRenderPipelineStateWithDescriptor:d error:nil] : nil;
+    m4_archive_note(ps != nil, started);
+    return ps;
+}
+
+static id<MTLComputePipelineState> m4_archive_compute(NvShader *cs) {
+    if (!atomic_load(&g_m4_archive_ready) || cs->builtin || !cs->key[0] || !m4_archive_seed_shader(cs)) return nil;
+    NvM4Archive *snapshot = m4_archive_candidate(@(cs->key));
+    if (!snapshot) return nil;
+    uint64_t started = bp_now();
+    MTL4ComputePipelineDescriptor *d = m4_archive_compute_desc(cs);
+    id<MTLComputePipelineState> ps = d ? [snapshot.archive newComputePipelineStateWithDescriptor:d error:nil] : nil;
+    m4_archive_note(ps != nil, started);
+    return ps;
+}
+
+static NvM4ArchiveBuild *m4_archive_build_begin(void) {
+    if (!m4_archive_mode() || g_m4_archive_saved || !m4_archive_seed_prefix()) return nil;
+    m4_archive_initialize();
+    if (g_m4_archive && m4_archive_mode() != 2) return nil;
+    NSURL *dir = m4_archive_directory();
+    NSNumber *room;
+    if (![NSFileManager.defaultManager createDirectoryAtURL:dir withIntermediateDirectories:YES attributes:nil error:nil] ||
+        ![dir getResourceValue:&room forKey:NSURLVolumeAvailableCapacityForImportantUsageKey error:nil] ||
+        room.unsignedLongLongValue < (192u << 20) || os_proc_available_memory() < (1024u << 20)) return nil;
+    MTL4PipelineDataSetSerializerDescriptor *sd = [MTL4PipelineDataSetSerializerDescriptor new];
+    sd.configuration = MTL4PipelineDataSetSerializerConfigurationCaptureBinaries;
+    MTL4CompilerDescriptor *cd = [MTL4CompilerDescriptor new];
+    cd.pipelineDataSetSerializer = [g_dev newPipelineDataSetSerializerWithDescriptor:sd];
+    if (!cd.pipelineDataSetSerializer) return nil;
+    NSError *error = nil;
+    id<MTL4Compiler> compiler = [g_dev newCompilerWithDescriptor:cd error:&error];
+    if (!compiler) {
+        MLOG("[metal4-archive] compiler unavailable: %s", error.localizedDescription.UTF8String ?: "unknown error");
+        return nil;
+    }
+    NvM4ArchiveBuild *build = [NvM4ArchiveBuild new];
+    build.compiler = compiler;
+    build.keys = [NSMutableSet set];
+    build.started = bp_now();
+    return build;
+}
+
+static bool m4_archive_build_can_add(NvM4ArchiveBuild *build, bool priority, uint64_t legacy_ns) {
+    return build && build.attempts < M4_ARCHIVE_LIMIT && bp_now() - build.started < 15000000000ull &&
+        (priority || legacy_ns >= PSO_PRIORITY_MIN_US * 1000ull) && os_proc_available_memory() >= (1024u << 20);
+}
+
+static void m4_archive_build_add(NvM4ArchiveBuild *build, MTL4PipelineDescriptor *d, id key) {
+    if (!d || !key || [build.keys containsObject:key]) return;
+    build.attempts++;
+    bool ok = [d isKindOfClass:MTL4ComputePipelineDescriptor.class]
+        ? [build.compiler newComputePipelineStateWithDescriptor:(MTL4ComputePipelineDescriptor *)d compilerTaskOptions:nil error:nil] != nil
+        : [build.compiler newRenderPipelineStateWithDescriptor:d compilerTaskOptions:nil error:nil] != nil;
+    if (ok) [build.keys addObject:key];
+}
+
+static void m4_archive_build_finish(NvM4ArchiveBuild *build) {
+    if (!build) return;
+    if (!build.keys.count || os_proc_available_memory() < (1024u << 20)) {
+        MLOG("[metal4-archive] skipped save (%lu eligible recipes)", (unsigned long)build.keys.count);
+        return;
+    }
+    NSURL *dir = m4_archive_directory();
+    NSString *name = [NSString stringWithFormat:@"pipelines-%@.metalbin", NSUUID.UUID.UUIDString];
+    NSURL *url = [dir URLByAppendingPathComponent:name];
+    NSError *error = nil;
+    id<MTL4PipelineDataSetSerializer> serializer = build.compiler.pipelineDataSetSerializer;
+    bool wrote = [serializer serializeAsArchiveAndFlushToURL:url error:&error];
+    NvM4Archive *snapshot = wrote ? m4_archive_open(url, build.keys) : nil;
+    NSDictionary *record = @{@"file": name, @"keys": build.keys.allObjects};
+    NSData *index = snapshot ? [NSPropertyListSerialization dataWithPropertyList:record
+        format:NSPropertyListBinaryFormat_v1_0 options:0 error:&error] : nil;
+    if (!index || atomic_load(&g_manual_warm_state) != MANUAL_WARM_RUNNING ||
+        ![index writeToURL:[dir URLByAppendingPathComponent:@"current.plist"] options:NSDataWritingAtomic error:&error]) {
+        MLOG("[metal4-archive] did not save: %s", error.localizedDescription.UTF8String ?: "invalid or oversized archive");
+        [NSFileManager.defaultManager removeItemAtURL:url error:nil];
+        return;
+    }
+    os_unfair_lock_lock(&g_m4_archive_lock);
+    g_m4_archive = snapshot;
+    atomic_store(&g_m4_archive_ready, true);
+    os_unfair_lock_unlock(&g_m4_archive_lock);
+    g_m4_archive_saved = true;
+    NSNumber *size;
+    [url getResourceValue:&size forKey:NSURLFileSizeKey error:nil];
+    MLOG("[metal4-archive] saved %lu exact recipes, %.1f MiB, %.2f s", (unsigned long)snapshot.keys.count,
+         size.doubleValue / (1 << 20), (bp_now() - build.started) / 1e9);
+}
+#endif
