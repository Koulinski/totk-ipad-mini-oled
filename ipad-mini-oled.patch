+static void pso_priority_record(char kind, const char *key, uint64_t cost_ns) {
+    uint64_t cost_us = MIN(cost_ns / 1000, PSO_PRIORITY_MAX_US);
+    if (cost_us < PSO_PRIORITY_MIN_US || !atomic_load_explicit(&g_world_on, memory_order_relaxed) ||
+        !pso_priority_enabled()) return;
+    @autoreleasepool {
+        NSString *row = [NSString stringWithFormat:@"%c\t%s", kind, key];
+        NSMutableDictionary<NSString *, NSNumber *> *scores = pso_priority_scores();
+        NSNumber *previous = scores[row];
+        if (cost_us <= previous.unsignedLongLongValue) return;
+        if (!previous && scores.count == PSO_PRIORITY_LIMIT) {
+            NSString *cheapest = nil;
+            uint64_t lowest = UINT64_MAX;
+            for (NSString *candidate in scores) {
+                uint64_t cost = scores[candidate].unsignedLongLongValue;
+                if (cost < lowest) { cheapest = candidate; lowest = cost; }
+            }
+            if (cost_us <= lowest) return;
+            [scores removeObjectForKey:cheapest];
+        }
+        scores[row] = @(cost_us);
+        g_pso_priority_dirty = true;
+    }
