+/* The submit thread owns the live scores; other threads read the file snapshot. */
+static NSMutableDictionary<NSString *, NSNumber *> *pso_priority_scores(void) {
+    if (!g_pso_priority) g_pso_priority = pso_priority_read();
+    return g_pso_priority;
+}
+
+static NSArray<NSString *> *pso_priority_order(NSDictionary<NSString *, NSNumber *> *scores) {
+    return [scores.allKeys sortedArrayUsingComparator:^NSComparisonResult(NSString *left, NSString *right) {
+        NSComparisonResult by_cost = [scores[right] compare:scores[left]];
+        return by_cost == NSOrderedSame ? [left compare:right] : by_cost;
+    }];
+}
