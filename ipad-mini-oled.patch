+static NSMutableDictionary<NSString *, NSNumber *> *pso_priority_read(void) {
+    NSMutableDictionary<NSString *, NSNumber *> *scores = [NSMutableDictionary dictionary];
+    NSString *path = pso_priority_path();
+    NSDictionary *attributes = [NSFileManager.defaultManager attributesOfItemAtPath:path error:nil];
+    if (![attributes[NSFileType] isEqual:NSFileTypeRegular] ||
+        attributes.fileSize > PSO_PRIORITY_LIMIT * (sizeof(pso_skey) * 2 + 32)) return scores;
+    NSString *content = [NSString stringWithContentsOfFile:path encoding:NSUTF8StringEncoding error:nil];
+    for (NSString *line in [content componentsSeparatedByString:@"\n"]) {
+        if (scores.count == PSO_PRIORITY_LIMIT) break;
+        NSRange tab = [line rangeOfString:@"\t"];
+        if (tab.location == NSNotFound || !tab.location || tab.location > 8) continue;
+        const char *score = line.UTF8String;
+        if (strspn(score, "0123456789") != tab.location) continue;
+        uint64_t cost = strtoull(score, NULL, 10);
+        if (cost < PSO_PRIORITY_MIN_US || cost > PSO_PRIORITY_MAX_US) continue;
+        NSString *row = pso_priority_recipe([line substringFromIndex:NSMaxRange(tab)]);
+        if (row && cost > scores[row].unsignedLongLongValue) scores[row] = @(cost);
+    }
+    return scores;
+}
