+@interface TOTKShaderOverlay : NSObject
+@property(nonatomic, strong) UIStackView *toolbar;
+@property(nonatomic, strong) UIButton *button;
+@property(nonatomic, strong) UIProgressView *compactProgress;
+@property(nonatomic, strong) UIStackView *card;
+@property(nonatomic, strong) UILabel *status;
+@property(nonatomic, strong) UILabel *counts;
+@property(nonatomic, strong) UIProgressView *progress;
+@property(nonatomic, strong) UIButton *action;
+@property(nonatomic, strong) UIButton *dismiss;
