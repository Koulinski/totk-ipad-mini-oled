+  [self.card.bottomAnchor constraintLessThanOrEqualToAnchor:safe.bottomAnchor constant:-12],
+  [buttons.heightAnchor constraintGreaterThanOrEqualToConstant:44]
+ ]];
+ [self refresh];
+ return self;
+}
+- (BOOL)isBuilding {
+ return self.state >= TOTKShaderPreparing && self.state <= TOTKShaderStopping;
+}
+- (void)refresh {
+ BOOL building = [self isBuilding];
+ float progress = self.total ? fminf(1, (float)((double)self.done / self.total)) : 0;
+ self.progress.progress = self.compactProgress.progress = progress;
+ self.progress.hidden = !building && !self.total;
+ self.compactProgress.hidden = !building || !self.card.hidden;
+ self.status.text = shader_build_message(self.state);
+ self.counts.hidden = !self.total;
+ if (self.total) {
+  self.counts.text = [NSString stringWithFormat:@(TOTK_UI("已处理 %llu/%llu，已准备 %llu，跳过 %llu",
+      "%llu/%llu processed · %llu prepared · %llu skipped")),
+      (unsigned long long)self.done, (unsigned long long)self.total,
+      (unsigned long long)self.built, (unsigned long long)self.skipped];
+ }
+ NSString *toolbarTitle = building && self.total
+     ? [NSString stringWithFormat:@(TOTK_UI("着色器 %.0f%%", "Shaders %.0f%%")), floor(progress * 100.0)]
+     : @(TOTK_UI("着色器", "Shaders"));
+ shader_button_title(self.button, toolbarTitle);
+ shader_button_title(self.action, building ? @(TOTK_UI("停止", "Stop")) : @(TOTK_UI("构建着色器", "Build Shaders")));
+ shader_button_title(self.dismiss, building ? @(TOTK_UI("隐藏", "Hide")) : @(TOTK_UI("完成", "Done")));
+ self.action.enabled = self.state != TOTKShaderStopping;
+}
+- (void)toggleCard {
+ self.card.hidden = !self.card.hidden;
+ [self refresh];
+ show_overlay_buttons();
+}
+- (void)performAction {
+ if ([self isBuilding]) {
+  self.state = TOTKShaderStopping;
+  mtl_manual_warm_cancel();
+ } else {
+  self.done = self.total = self.built = self.skipped = 0;
+  self.state = mtl_manual_warm_start() ? TOTKShaderPreparing : TOTKShaderBusy;
+ }
+ [self refresh];
+ show_overlay_buttons();
+}
+- (void)updateDone:(uint64_t)done total:(uint64_t)total built:(uint64_t)built skipped:(uint64_t)skipped state:(TOTKShaderBuildState)state {
+ BOOL wasBuilding = self.isBuilding;
+ self.done = done;
+ self.total = total;
+ self.built = built;
+ self.skipped = skipped;
+ if (self.state != TOTKShaderStopping || (state != TOTKShaderPreparing && state != TOTKShaderRunning)) self.state = state;
+ [self refresh];
+ if (wasBuilding != self.isBuilding) show_overlay_buttons();
+}
+@end
