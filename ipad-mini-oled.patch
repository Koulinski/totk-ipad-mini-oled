+
+static NSString *pso_priority_recipe(NSString *row) {
+    if ([row hasPrefix:@"C\t"]) return pso_priority_shader_key(row.UTF8String + 2, 80) ? row : nil;
+    if (![row hasPrefix:@"R\t"]) return nil;
+    pso_skey sk;
+    if (pso_skey_parse(row.UTF8String + 2, &sk) || sk.fz || sk.merged > 1 ||
+        (sk.k.a2c & PSO_VBORDER) || sk.vs_stage != 0 || !pso_priority_shader_key(sk.vs, sizeof sk.vs) ||
+        (sk.fs[0] && (sk.fs_stage != 1 || !pso_priority_shader_key(sk.fs, sizeof sk.fs)))) return nil;
+    return pso_render_row(&sk);
+}
