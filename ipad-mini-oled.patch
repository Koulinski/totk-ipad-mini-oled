index 0000000000000000000000000000000000000000..9ba41be0b9959fc7c0967e65e84dff8205da44ca
--- /dev/null
+++ b/games/totk/third_party/d2r_gfx/gfx/nvn/nvn_vborder_key.h
@@ -0,0 +1,43 @@
+#pragma once
+
+#include <float.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+
+enum { NVN_VBORDER_CAP = 8, NVN_VBORDER_SAMPLER_BYTES = 20 };
+
+typedef struct {
+    uint32_t aid;
+    uint32_t rgba_bits[4];
+} nvn_vborder_sampler;
+
+/* Runtime-only key component. Zero-initialize before adding samplers in
+   reflection order. A failed append leaves the key untouched; the caller
+   must fall back instead of looking up a partial tuple. */
+typedef struct {
+    uint32_t count;
+    nvn_vborder_sampler samplers[NVN_VBORDER_CAP];
+} nvn_vborder_key;
+
+_Static_assert(sizeof(float) == sizeof(uint32_t) && FLT_RADIX == 2 &&
+               FLT_MANT_DIG == 24 && FLT_MAX_EXP == 128, "binary32 sampler colors");
+_Static_assert(sizeof(nvn_vborder_sampler) == NVN_VBORDER_SAMPLER_BYTES, "exact sampler tuple layout");
+_Static_assert(sizeof(nvn_vborder_key) == 4 + NVN_VBORDER_CAP * NVN_VBORDER_SAMPLER_BYTES,
+               "exact sampler key has no padding");
+
+static inline bool nvn_vborder_key_append_bits(nvn_vborder_key *key, const nvn_vborder_sampler *sampler) {
+    if (key->count >= NVN_VBORDER_CAP || sampler->aid > UINT16_MAX) return false;
+    for (unsigned channel = 0; channel < 4; channel++)
+        if ((sampler->rgba_bits[channel] & UINT32_C(0x7f800000)) == UINT32_C(0x7f800000)) return false;
+    for (unsigned i = 0; i < key->count; i++)
+        if (key->samplers[i].aid == sampler->aid) return false;
+    key->samplers[key->count++] = *sampler;
+    return true;
+}
+
+static inline bool nvn_vborder_key_append(nvn_vborder_key *key, uint32_t aid, const float rgba[4]) {
+    nvn_vborder_sampler sampler = {.aid = aid};
+    memcpy(sampler.rgba_bits, rgba, sizeof sampler.rgba_bits);
+    return nvn_vborder_key_append_bits(key, &sampler);
+}
