+@property(nonatomic) uint64_t done, total, built, skipped;
+- (instancetype)initInView:(UIView *)host;
+- (BOOL)isBuilding;
+- (void)updateDone:(uint64_t)done total:(uint64_t)total built:(uint64_t)built skipped:(uint64_t)skipped state:(TOTKShaderBuildState)state;
+@end
+static TOTKShaderOverlay *shaderOverlay;
+
+@implementation TOTKShaderOverlay
+- (instancetype)initInView:(UIView *)host {
+ if (!(self = [super init])) return nil;
+ UILayoutGuide *safe = host.safeAreaLayoutGuide;
+ UIButtonConfiguration *configuration = UIButtonConfiguration.filledButtonConfiguration;
+ configuration.baseBackgroundColor = [UIColor colorWithWhite:0.10 alpha:0.85];
+ configuration.baseForegroundColor = UIColor.whiteColor;
+ self.button = [UIButton buttonWithConfiguration:configuration primaryAction:nil];
+ [self.button addTarget:self action:@selector(toggleCard) forControlEvents:UIControlEventTouchUpInside];
+ self.compactProgress = [[UIProgressView alloc] initWithProgressViewStyle:UIProgressViewStyleBar];
+ self.compactProgress.progressTintColor = UIColor.systemTealColor;
+ self.compactProgress.trackTintColor = [UIColor colorWithWhite:0.32 alpha:1];
+ self.compactProgress.accessibilityLabel = @(TOTK_UI("着色器预编译进度", "Shader build progress"));
+ self.toolbar = [[UIStackView alloc] initWithArrangedSubviews:@[self.button, self.compactProgress]];
+ self.toolbar.axis = UILayoutConstraintAxisVertical;
+ self.toolbar.spacing = 3;
+ self.toolbar.translatesAutoresizingMaskIntoConstraints = NO;
+ self.toolbar.hidden = YES;
+ [host addSubview:self.toolbar];
+ [NSLayoutConstraint activateConstraints:@[
+  [self.toolbar.trailingAnchor constraintEqualToAnchor:safe.trailingAnchor constant:-12],
+  [self.toolbar.topAnchor constraintEqualToAnchor:safe.topAnchor constant:4],
+  [self.button.heightAnchor constraintGreaterThanOrEqualToConstant:44],
+  [self.button.widthAnchor constraintGreaterThanOrEqualToConstant:104]
+ ]];
+
+ UILabel *title = [UILabel new];
+ title.text = @(TOTK_UI("着色器预编译", "Shader Builder"));
+ title.textColor = UIColor.whiteColor;
+ title.font = [UIFont systemFontOfSize:20 weight:UIFontWeightSemibold];
+ title.accessibilityTraits = UIAccessibilityTraitHeader;
+ self.status = [UILabel new];
+ self.status.textColor = UIColor.whiteColor;
+ self.status.font = [UIFont systemFontOfSize:14];
+ self.status.numberOfLines = 0;
+ self.counts = [UILabel new];
+ self.counts.textColor = [UIColor colorWithWhite:0.80 alpha:1];
+ self.counts.font = [UIFont monospacedDigitSystemFontOfSize:13 weight:UIFontWeightRegular];
+ self.counts.numberOfLines = 0;
+ self.progress = [[UIProgressView alloc] initWithProgressViewStyle:UIProgressViewStyleBar];
+ self.progress.progressTintColor = UIColor.systemTealColor;
+ self.progress.trackTintColor = self.compactProgress.trackTintColor;
+ self.progress.accessibilityLabel = self.compactProgress.accessibilityLabel;
+
+ UIButtonConfiguration *actionStyle = UIButtonConfiguration.filledButtonConfiguration;
+ actionStyle.baseBackgroundColor = UIColor.systemTealColor;
+ actionStyle.baseForegroundColor = UIColor.blackColor;
+ self.action = [UIButton buttonWithConfiguration:actionStyle primaryAction:nil];
+ self.dismiss = [UIButton buttonWithConfiguration:UIButtonConfiguration.grayButtonConfiguration primaryAction:nil];
+ [self.action addTarget:self action:@selector(performAction) forControlEvents:UIControlEventTouchUpInside];
+ [self.dismiss addTarget:self action:@selector(toggleCard) forControlEvents:UIControlEventTouchUpInside];
+ UIStackView *buttons = [[UIStackView alloc] initWithArrangedSubviews:@[self.action, self.dismiss]];
+ buttons.distribution = UIStackViewDistributionFillProportionally;
+ buttons.spacing = 8;
+
+ self.card = [[UIStackView alloc] initWithArrangedSubviews:@[title, self.status, self.progress, self.counts, buttons]];
+ self.card.axis = UILayoutConstraintAxisVertical;
+ self.card.spacing = 10;
+ self.card.layoutMarginsRelativeArrangement = YES;
+ self.card.layoutMargins = UIEdgeInsetsMake(14, 16, 14, 16);
+ self.card.backgroundColor = [UIColor colorWithWhite:0.08 alpha:0.94];
+ self.card.layer.cornerRadius = 14;
+ self.card.translatesAutoresizingMaskIntoConstraints = NO;
+ self.card.hidden = YES;
+ [host addSubview:self.card];
