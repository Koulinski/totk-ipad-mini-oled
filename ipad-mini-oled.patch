+typedef NS_ENUM(NSUInteger, TOTKShaderBuildState) {
+ TOTKShaderReady, TOTKShaderPreparing, TOTKShaderRunning, TOTKShaderStopping,
+ TOTKShaderComplete, TOTKShaderCancelled, TOTKShaderBackgrounded,
+ TOTKShaderTimeBudget, TOTKShaderMemoryBudget, TOTKShaderUnavailable, TOTKShaderBusy
+};
+
+static NSString *shader_build_message(TOTKShaderBuildState state) {
+ switch (state) {
+  case TOTKShaderReady: return @(TOTK_UI("预编译更多已知的渲染管线。建议在标题画面或游戏菜单中运行。",
+      "Prepare more known pipelines. Run this from the title screen or an in-game menu."));
+  case TOTKShaderPreparing: return @(TOTK_UI("正在准备管线清单…", "Preparing the pipeline list…"));
+  case TOTKShaderRunning: return @(TOTK_UI("正在预编译着色器与管线…", "Building shaders and pipelines…"));
+  case TOTKShaderStopping: return @(TOTK_UI("正在停止…", "Stopping…"));
+  case TOTKShaderComplete: return @(TOTK_UI("预编译已完成。", "Shader build finished."));
+  case TOTKShaderCancelled: return @(TOTK_UI("预编译已停止。", "Shader build stopped."));
+  case TOTKShaderBackgrounded: return @(TOTK_UI("应用退出前台时停止了预编译。", "Shader build stopped when the app left the foreground."));
+  case TOTKShaderTimeBudget: return @(TOTK_UI("已达到预编译时间上限。", "The shader build reached its time limit."));
+  case TOTKShaderMemoryBudget: return @(TOTK_UI("可用内存不足，预编译已停止。", "Shader build stopped because available memory was low."));
+  case TOTKShaderUnavailable: return @(TOTK_UI("当前没有可预编译的管线。", "No pipeline recipes are available to build."));
+  case TOTKShaderBusy: return @(TOTK_UI("着色器编译器正忙。请稍后重试。", "The shader builder is busy. Try again shortly."));
+ }
+}
