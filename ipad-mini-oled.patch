+static NSTimer *overlayButtonTimer;
+static BOOL overlayGameplayTouchActive;
+
+static BOOL overlay_buttons_pinned(void) {
+ return overlayGameplayTouchActive || !shaderOverlay.card.hidden || shaderOverlay.isBuilding || statsButton.menuOpen;
+}
+
+static void show_overlay_buttons(void) {
+ if (!bootOverlay.hidden || !shaderOverlay) return;
+ shaderOverlay.toolbar.hidden = NO;
+ statsButton.hidden = NO;
+ [overlayButtonTimer invalidate];
+ overlayButtonTimer = nil;
+ if (overlay_buttons_pinned()) return;
+ overlayButtonTimer = [NSTimer scheduledTimerWithTimeInterval:4 repeats:NO block:^(NSTimer *timer) {
+  (void)timer;
+  overlayButtonTimer = nil;
+  if (overlay_buttons_pinned()) return;
+  if (shaderOverlay.button.tracking || statsButton.tracking) {
+   show_overlay_buttons();
+   return;
+  }
+  shaderOverlay.toolbar.hidden = YES;
+  statsButton.hidden = YES;
+ }];
